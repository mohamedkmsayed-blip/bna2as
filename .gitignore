# .gitignore for B.L.A.S.T. Projects

# Environment variables - NEVER commit these
.env
.env.local
.env.*.local

# Temporary files
.tmp/
tmp/
temp/
*.tmp

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project-specific intermediates
.tmp/*
!.tmp/.gitkeep